rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Handles collection: unique registry for user handles
    match /handles/{handle} {
      allow read: if signedIn();
      allow create: if signedIn()
        && isValidId(handle)
        && handle.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid']);
      allow update, delete: if false;
    }

    // Public profiles: readable by any authenticated user for discovery
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create: if isUser(uid)
        && request.resource.data.keys().hasAll(['displayName', 'handle', 'avatarColor'])
        && request.resource.data.keys().hasOnly(['displayName', 'handle', 'avatarColor', 'createdAt', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.handle is string
        && request.resource.data.handle.matches('^[a-z0-9_]{3,20}$')
        && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == request.auth.uid
        && request.resource.data.avatarColor is string;
      allow update: if isUser(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'handle', 'avatarColor', 'createdAt', 'updatedAt'])
        && request.resource.data.handle == resource.data.handle
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.avatarColor is string;
      allow delete: if false;
    }

    // Private user documents & user-scoped subcollections
    match /users/{uid} {
      allow read: if isUser(uid);
      allow create: if isUser(uid)
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'handle', 'primaryUse', 'lastWorkspace', 'timezone', 'currency', 'defaultMonthlyBudgetMinor', 'theme', 'avatarColor', 'onboardingComplete', 'createdAt', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.handle is string
        && request.resource.data.handle.matches('^[a-z0-9_]{3,20}$')
        && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == request.auth.uid
        && request.resource.data.primaryUse in ['personal', 'professional']
        && request.resource.data.lastWorkspace in ['personal', 'professional']
        && request.resource.data.currency in ['INR', 'USD', 'EUR', 'GBP', 'AED', 'SGD']
        && request.resource.data.defaultMonthlyBudgetMinor is int
        && request.resource.data.defaultMonthlyBudgetMinor >= 0;
      allow update: if isUser(uid)
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'handle', 'primaryUse', 'lastWorkspace', 'timezone', 'currency', 'defaultMonthlyBudgetMinor', 'theme', 'avatarColor', 'onboardingComplete', 'createdAt', 'updatedAt'])
        && request.resource.data.handle == resource.data.handle
        && request.resource.data.email == resource.data.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.primaryUse in ['personal', 'professional']
        && request.resource.data.lastWorkspace in ['personal', 'professional']
        && request.resource.data.currency in ['INR', 'USD', 'EUR', 'GBP', 'AED', 'SGD']
        && request.resource.data.defaultMonthlyBudgetMinor is int
        && request.resource.data.defaultMonthlyBudgetMinor >= 0;
      allow delete: if false;

      // Tasks subcollection
      match /tasks/{taskId} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && request.resource.data.workspace in ['personal', 'professional']
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 1
          && request.resource.data.title.size() <= 120
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 2000
          && request.resource.data.priority in ['low', 'medium', 'high']
          && request.resource.data.status in ['pending', 'completed']
          && request.resource.data.category is string
          && request.resource.data.category.size() <= 40;
      }

      // Calendar Events subcollection
      match /events/{eventId} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && request.resource.data.workspace in ['personal', 'professional']
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 1
          && request.resource.data.title.size() <= 120
          && request.resource.data.date is string
          && request.resource.data.startTime is string
          && request.resource.data.endTime is string;
      }

      // Financial Transactions / Expenses
      match /expenses/{expenseId} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && request.resource.data.type in ['income', 'expense']
          && request.resource.data.amountMinor is int
          && request.resource.data.amountMinor > 0
          && request.resource.data.category is string
          && request.resource.data.category.size() >= 1
          && request.resource.data.category.size() <= 50
          && request.resource.data.date is string;
      }

      // Monthly Budgets
      match /budgets/{month} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && request.resource.data.budgetMinor is int
          && request.resource.data.budgetMinor >= 0;
      }

      // Notes & Meeting Minutes
      match /notes/{noteId} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && request.resource.data.workspace in ['personal', 'professional']
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 1
          && request.resource.data.title.size() <= 150
          && request.resource.data.content is string;
      }

      // Goals
      match /goals/{goalId} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && request.resource.data.workspace in ['personal', 'professional']
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 1
          && request.resource.data.title.size() <= 120
          && request.resource.data.targetDate is string
          && request.resource.data.currentProgress is int
          && request.resource.data.targetProgress is int
          && request.resource.data.targetProgress > 0;
      }

      // Habits
      match /habits/{habitId} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && request.resource.data.workspace in ['personal', 'professional']
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 100
          && request.resource.data.frequency in ['daily', 'weekdays', 'weekly'];
      }

      // Notifications
      match /notifications/{notifId} {
        allow read, delete: if isUser(uid);
        allow create, update: if signedIn(); // Users can create notifications for another user (e.g. invitation)
      }
    }

    // Professional Meetings collection
    match /meetings/{meetingId} {
      allow read: if signedIn() && (
        resource.data.organizerId == request.auth.uid ||
        request.auth.uid in resource.data.participantUids
      );
      allow create: if signedIn()
        && request.resource.data.organizerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.date is string
        && request.resource.data.startTime is string
        && request.resource.data.endTime is string
        && request.resource.data.status in ['scheduled', 'cancelled'];
      allow update: if signedIn() && (
        resource.data.organizerId == request.auth.uid ||
        request.auth.uid in resource.data.participantUids
      );
      allow delete: if signedIn() && resource.data.organizerId == request.auth.uid;
    }

    // Meeting Invitations collection
    match /meetingInvitations/{invitationId} {
      allow read: if signedIn() && (
        resource.data.inviteeUid == request.auth.uid ||
        resource.data.organizerId == request.auth.uid
      );
      allow create: if signedIn()
        && request.resource.data.organizerId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.inviteeUid == request.auth.uid ||
        resource.data.organizerId == request.auth.uid
      );
      allow delete: if signedIn() && (
        resource.data.inviteeUid == request.auth.uid ||
        resource.data.organizerId == request.auth.uid
      );
    }

    // Professional Conversations
    match /conversations/{convId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantUids;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantUids;
      allow update: if signedIn() && request.auth.uid in resource.data.participantUids;
      allow delete: if false;

      // Messages inside a conversation
      match /messages/{msgId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantUids;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantUids
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.content is string
          && request.resource.data.content.size() >= 1
          && request.resource.data.content.size() <= 2000;
        allow update, delete: if false;
      }
    }
  }
}
